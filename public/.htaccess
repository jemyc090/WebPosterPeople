# ─────────────────────────────────────────────────────────────────────────────
# Poster People — configuración para Apache
# Sube este archivo junto con el contenido de la carpeta dist/ (Vite lo copia
# automáticamente a dist/ al correr `npm run build`).
# ─────────────────────────────────────────────────────────────────────────────

Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Para forzar HTTPS, quita el "#" de las dos líneas siguientes
  # (solo cuando el certificado SSL ya esté activo en el servidor).
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Si el archivo o la carpeta existen (imágenes, JS, CSS), se sirven tal cual
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todas las demás rutas (/servicios, /categorias/..., etc.) las resuelve React
  RewriteRule ^ index.html [L]
</IfModule>

# Compresión de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Caché: los archivos de /assets llevan hash en el nombre, se pueden cachear 1 año.
# index.html no se cachea para que los cambios se vean al momento.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|gif|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
